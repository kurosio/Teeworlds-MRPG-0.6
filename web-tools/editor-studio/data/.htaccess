# Defense in depth: data/ holds credentials (db-config.json), dumps and guest change requests.
# Never serve it directly (the Docker apache-config.conf also denies it).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
