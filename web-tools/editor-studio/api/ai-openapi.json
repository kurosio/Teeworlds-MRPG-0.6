{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "Teeworlds-MRPG-0.6 Editor Studio Universal AI & MCP API",
    "version": "2.0.0",
    "summary": "Model-agnostic universal AI content creation, inspection, validation, dry-run diff preview, MCP JSON-RPC 2.0, and Change Request API for game database tables, scenario JSON files, and DDNet v4 maps.",
    "description": "Autonomous model-agnostic AI integration platform for Teeworlds-MRPG-0.6 Editor Studio. Share a single link (/ai or /) for instant self-discovery via /.well-known/ai-plugin.json, /openapi.json, /mcp, or /api/ai.php?action=manifest. Authenticate with a scoped Bearer AI token (Authorization: Bearer esai_<token>) or guest cookie session. Direct SQL/disk mutations are impossible; writes submit reversible Change Requests reviewed by an administrator."
  },
  "servers": [
    {
      "url": ".",
      "description": "Editor Studio base URL (relative to root or /editor-studio/)"
    }
  ],
  "tags": [
    { "name": "discovery", "description": "Single-link AI onboarding (/ai), plugin manifest, OpenAPI schema, and live role-filtered capabilities" },
    { "name": "auth", "description": "Scoped Bearer AI tokens, guest session login, and CSRF bootstrap" },
    { "name": "read", "description": "Paginated filtered reads across DB tables, scenarios/*.json, lookup sources, DDNet maps, references, and history" },
    { "name": "authoring", "description": "Validation, dry-run diff preview, safe JSON patch_json merge, object copy, and Change Request submission" },
    { "name": "mcp", "description": "Model Context Protocol (JSON-RPC 2.0) HTTP server endpoint" },
    { "name": "requests", "description": "Guest change-request status polling, withdrawal, and admin review dialog" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "esai_<token>",
        "description": "Scoped AI Bearer token issued by an administrator in Guests & AI Tokens UI. Enforces read/create/update/delete scopes and guest tab ACLs without requiring cookie CSRF."
      },
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "PHPSESSID",
        "description": "PHP session cookie obtained via /api/auth.php?action=status or guest_login."
      },
      "CsrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Editor-CSRF",
        "description": "64-hex CSRF token returned by GET /api/auth.php?action=status. Required for cookie-authenticated POSTs together with matching Origin header (not required when using BearerAuth)."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["ok", "code", "error"],
        "properties": {
          "ok": { "const": false },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error identifier (e.g. auth_required, invalid_token, token_revoked, token_expired, scope_forbidden, confirmation_required, resource_forbidden, guest_forbidden, unknown_resource, unknown_field, unknown_filter_field, invalid_json, validation_failed, version_conflict, base_hash_mismatch, request_not_pending, rate_limited, method_not_allowed, unsupported_media_type, missing_origin, cross_origin_forbidden, csrf_token, payload_too_large)."
          },
          "error": { "type": "string", "description": "Human-readable error description." },
          "field": { "type": ["string", "null"] },
          "errors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ValidationIssue" }
          },
          "warnings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ValidationIssue" }
          },
          "dangerous_actions": {
            "type": "array",
            "items": { "type": "object" }
          },
          "requires_confirmation": { "type": "boolean" },
          "allowed": { "type": "array", "items": { "type": "string" } },
          "conflicts": { "type": "array", "items": { "type": "object" } },
          "version": { "type": "integer", "description": "Current pending request version when version_conflict occurs." },
          "retry_after": { "type": "integer", "description": "Seconds until rate limit clears when rate_limited occurs." }
        }
      },
      "ValidationIssue": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "operationIndex": { "type": ["integer", "null"], "description": "Zero-based index in operations[]" },
          "resource": { "type": "string" },
          "code": { "type": "string" },
          "field": { "type": ["string", "null"] },
          "message": { "type": "string" }
        }
      },
      "DbOperation": {
        "type": "object",
        "required": ["resource"],
        "properties": {
          "resource": {
            "type": "string",
            "description": "Allowed DB resource key from manifest.resources (excluding scenarios/maps)."
          },
          "type": { "type": "string", "enum": ["create", "update", "copy", "delete"], "description": "Canonical operation type (alias: action)." },
          "action": { "type": "string", "enum": ["create", "update", "copy", "delete"], "description": "Alias for type." },
          "id": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "Required for update/delete; omit for create/copy."
          },
          "source_id": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "Required for copy: existing source DB record ID to clone."
          },
          "tempId": {
            "type": ["integer", "null"],
            "minimum": 2000000000,
            "maximum": 2000999999,
            "description": "Optional explicit temporary ID (2000000000..2000999999) on DB create/copy (auto-assigned sequentially if omitted)."
          },
          "data": {
            "type": "object",
            "description": "Column-to-value map matching the resource schema."
          },
          "patch_json": {
            "type": "object",
            "description": "RFC 7396 JSON Merge Patch map keyed by JSON column name (e.g. {\"Data\": {\"bonus\": {\"atk\": 5}}}) preserving existing sibling keys."
          },
          "expected_before": {
            "type": "object",
            "description": "Optimistic concurrency expectation: map of column names to expected current values in DB; mismatches abort with 409 version_conflict."
          }
        }
      },
      "ScenarioOperation": {
        "type": "object",
        "required": ["resource"],
        "properties": {
          "resource": { "const": "scenarios" },
          "type": { "type": "string", "enum": ["create", "update", "copy", "delete"] },
          "action": { "type": "string", "enum": ["create", "update", "copy", "delete"] },
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\p{L}][A-Za-z0-9\\p{L}._ -]*\\.json$",
            "description": "Scenario filename under scenarios/ (alias: id)."
          },
          "id": {
            "type": "string",
            "description": "Alias for filename."
          },
          "source_filename": {
            "type": "string",
            "description": "Source scenario filename for action=copy."
          },
          "baseHash": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hex digest from get&resource=scenarios to reject stale updates (409 base_hash_mismatch)."
          },
          "patch_json": {
            "type": "object",
            "description": "RFC 7396 merge patch applied cleanly over the existing scenario JSON content without wiping untouched sections."
          },
          "data": {
            "type": "object",
            "description": "Wrapper object containing { content: <ScenarioObject> }."
          }
        }
      },
      "Operation": {
        "oneOf": [
          { "$ref": "#/components/schemas/DbOperation" },
          { "$ref": "#/components/schemas/ScenarioOperation" }
        ]
      },
      "OperationsRequest": {
        "type": "object",
        "required": ["operations"],
        "properties": {
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/Operation" }
          }
        }
      },
      "ProposeRequest": {
        "type": "object",
        "required": ["message", "operations"],
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40,
            "description": "Optional author label; defaults to the guest account display name/login."
          },
          "message": {
            "type": "string",
            "minLength": 3,
            "maxLength": 800,
            "description": "Clear explanation of the proposed fix or addition for the reviewing administrator."
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/Operation" }
          },
          "confirm_dangerous": {
            "type": "boolean",
            "default": false,
            "description": "Required true when submitting deletes, clearing non-empty JSON, batches >10 ops, or editing worlds/dungeons/vouchers."
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 120,
            "description": "Optional deduplication key so retrying the same HTTP submission never creates duplicate pending requests."
          },
          "request_id": {
            "type": "string",
            "description": "Set when revising an existing pending change request owned by the caller."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Required optimistic lock version matching the pending request when request_id is set."
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": ["total", "limit", "offset", "has_more", "next_offset", "truncated", "max_bytes"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1 },
          "offset": { "type": "integer", "minimum": 0 },
          "has_more": { "type": "boolean" },
          "next_offset": { "type": ["integer", "null"] },
          "truncated": { "type": "boolean", "description": "True when rows were capped early to respect max_bytes." },
          "max_bytes": { "type": "integer" },
          "bytes": { "type": "integer" }
        }
      }
    }
  },
  "paths": {
    "/ai": {
      "get": {
        "tags": ["discovery"],
        "operationId": "aiLanding",
        "summary": "Public single-link onboarding page (HTML or JSON via ?format=json or Accept: application/json)",
        "parameters": [
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["html", "json"] } }
        ],
        "responses": {
          "200": { "description": "Human & model-readable onboarding guide and connection metadata" }
        }
      }
    },
    "/.well-known/ai-plugin.json": {
      "get": {
        "tags": ["discovery"],
        "operationId": "wellKnownPlugin",
        "summary": "Standard machine-readable AI plugin discovery manifest",
        "responses": {
          "200": { "description": "Plugin metadata linking /ai, /openapi.json, and /mcp" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["discovery"],
        "operationId": "openapiRoot",
        "summary": "Public OpenAPI 3.1.0 schema JSON",
        "responses": {
          "200": { "description": "OpenAPI 3.1.0 specification" }
        }
      }
    },
    "/mcp": {
      "get": {
        "tags": ["mcp"],
        "operationId": "mcpInfo",
        "summary": "Public MCP server transport metadata & tool list",
        "responses": {
          "200": { "description": "MCP capabilities summary" }
        }
      },
      "post": {
        "tags": ["mcp"],
        "operationId": "mcpJsonRpc",
        "summary": "MCP JSON-RPC 2.0 endpoint (initialize, tools/list, tools/call, resources/list, resources/read, prompts/list, prompts/get)",
        "security": [{ "BearerAuth": [] }, { "SessionCookie": [] }],
        "responses": {
          "200": { "description": "JSON-RPC 2.0 response" },
          "204": { "description": "Notification acknowledged" }
        }
      }
    },
    "/api/auth.php": {
      "get": {
        "tags": ["auth"],
        "operationId": "authGet",
        "summary": "Read session auth state and obtain initial CSRF token",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["status", "csrf"], "default": "status" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current auth status and X-Editor-CSRF token",
            "content": {
              "application/json": {
                "examples": {
                  "anonymous": {
                    "value": {
                      "ok": true,
                      "authorized": false,
                      "role": null,
                      "csrf": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                      "guest": { "enabled": true, "accounts": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["auth"],
        "operationId": "authPost",
        "summary": "Sign in as a guest account or log out",
        "security": [{ "SessionCookie": [], "CsrfHeader": [] }],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["guest_login", "logout"] }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "examples": {
                "guestLogin": {
                  "value": { "login": "ai_bot", "password": "secret-password" }
                },
                "logout": { "value": {} }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated guest session with rotated CSRF token",
            "content": {
              "application/json": {
                "examples": {
                  "guestLoggedIn": {
                    "value": {
                      "ok": true,
                      "authorized": true,
                      "role": "guest",
                      "csrf": "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210",
                      "guest_key": "a1b2c3d4e5f6..."
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "CSRF/Origin failure or guest access disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Login throttled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/ai.php": {
      "get": {
        "tags": ["discovery", "read"],
        "operationId": "aiGet",
        "summary": "Discover OpenAPI/manifest schemas or inspect DB tables, scenarios, lookups, maps, references, and history",
        "security": [{ "BearerAuth": [] }, { "SessionCookie": [] }],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["discovery", "openapi", "manifest", "resources", "list", "get", "references", "history"]
            }
          },
          { "name": "include_schemas", "in": "query", "schema": { "type": "string", "enum": ["0", "1"], "default": "1" }, "description": "For action=manifest: set 0 for a compact summary without per-resource column schemas." },
          { "name": "include_examples", "in": "query", "schema": { "type": "string", "enum": ["0", "1"], "default": "1" }, "description": "For action=resources: include realistic create/patch_json/copy examples." },
          { "name": "resource", "in": "query", "schema": { "type": "string" }, "description": "Target resource key (e.g. items, quests, quest_bots, scenarios, maps, or lookup name)." },
          { "name": "id", "in": "query", "schema": { "type": "string" }, "description": "Integer primary key for DB/lookup/world records or scenario filename for scenarios." },
          { "name": "file", "in": "query", "schema": { "type": "string" }, "description": "Alias for id when resource=scenarios." },
          { "name": "world", "in": "query", "schema": { "type": "integer", "minimum": 0 }, "description": "World ID when resource=maps." },
          { "name": "path", "in": "query", "schema": { "type": "string" }, "description": "Relative .map path under data/maps/ or maps/ when resource=maps." },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Case-insensitive text search." },
          { "name": "filter", "in": "query", "schema": { "type": "string" }, "description": "JSON object mapping allowed column names to exact scalar, null, or IN-array values (e.g. {\"Type\":\"Quest\"})." },
          { "name": "filter_key", "in": "query", "schema": { "type": "string" }, "description": "Alternative single-column filter name." },
          { "name": "filter_value", "in": "query", "schema": { "type": "string" }, "description": "Exact value for filter_key." },
          { "name": "filter_values", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated IN-list for filter_key." },
          { "name": "fields", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated list of allowed columns to project on DB list/get (PK is always included)." },
          { "name": "decode", "in": "query", "schema": { "type": "string", "enum": ["0", "1"], "default": "1" }, "description": "Decode DB JSON text columns automatically into JSON values." },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "max_bytes", "in": "query", "schema": { "type": "integer", "minimum": 4096, "maximum": 2097152, "default": 524288 }, "description": "Response JSON byte budget for paginated lists (sets truncated=true when reached)." },
          { "name": "summary_only", "in": "query", "schema": { "type": "string", "enum": ["0", "1"], "default": "0" }, "description": "For get&resource=scenarios: omit raw content JSON and return summary + hash + metadata only." },
          { "name": "include_references", "in": "query", "schema": { "type": "string", "enum": ["0", "1"], "default": "0" }, "description": "For get: include outbound and inbound references permitted for caller." },
          { "name": "include_entities", "in": "query", "schema": { "type": "string", "enum": ["0", "1"], "default": "0" }, "description": "For get&resource=maps: include extracted entity/switch coordinates." },
          { "name": "x", "in": "query", "schema": { "type": "integer" }, "description": "For get&resource=maps: pixel X coordinate for tile walkability probe." },
          { "name": "y", "in": "query", "schema": { "type": "integer" }, "description": "For get&resource=maps: pixel Y coordinate for tile walkability probe." },
          { "name": "source", "in": "query", "schema": { "type": "string" }, "description": "For action=references: lookup dictionary name (items, quests, quest_boards, worlds, skills, bots, attributes)." }
        ],
        "responses": {
          "200": {
            "description": "Requested OpenAPI spec, manifest, list page, single object, or reference inspection",
            "content": {
              "application/json": {
                "examples": {
                  "manifest": {
                    "value": {
                      "ok": true,
                      "manifest": {
                        "api_version": "1.0",
                        "openapi": "api/ai.php?action=openapi",
                        "auth": { "role": "guest", "direct_db_writes_allowed": false, "submission_workflow": "guest_change_request" },
                        "pagination": { "default_limit": 50, "max_limit": 500, "default_max_bytes": 524288, "max_response_bytes": 2097152 },
                        "resources_summary": { "items": { "kind": "database", "pk": "ID", "permissions": { "read": true, "propose": true } } },
                        "resources": { "items": { "kind": "database", "table": "tw_items_list", "pk": "ID" } }
                      }
                    }
                  },
                  "paginatedList": {
                    "value": {
                      "ok": true,
                      "resource": "items",
                      "rows": [{ "ID": 10, "Name": "Bronze Sword", "Type": "Equip weapon" }],
                      "total": 42,
                      "limit": 1,
                      "offset": 0,
                      "has_more": true,
                      "next_offset": 1,
                      "truncated": false,
                      "max_bytes": 524288,
                      "bytes": 62
                    }
                  },
                  "getMapPoint": {
                    "value": {
                      "ok": true,
                      "resource": "maps",
                      "available": true,
                      "map": {
                        "format": "DDNet v4",
                        "width_tiles": 64,
                        "height_tiles": 48,
                        "point_check": { "x": 496, "y": 496, "tile_x": 15, "tile_y": 15, "in_bounds": true, "solid": false, "walkable": true }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid parameters, unknown field/filter, or invalid ID", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "Authentication required (except action=openapi)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "403": { "description": "Resource or lookup not enabled for caller", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Unknown resource or record/scenario not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "tags": ["authoring"],
        "operationId": "aiPost",
        "summary": "Validate operations, preview diffs/conflicts, or propose/revise a guest change request",
        "security": [{ "BearerAuth": [] }, { "SessionCookie": [], "CsrfHeader": [] }],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["validate", "preview", "propose"] }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/OperationsRequest" },
                  { "$ref": "#/components/schemas/ProposeRequest" }
                ]
              },
              "examples": {
                "validateMultiOp": {
                  "summary": "Validate creating an item with tempId and referencing it from a scenario",
                  "value": {
                    "operations": [
                      {
                        "resource": "items",
                        "action": "create",
                        "tempId": 2000000101,
                        "data": { "Name": "Rune Key", "Description": "Opens the gate", "Type": "Quest" }
                      },
                      {
                        "resource": "scenarios",
                        "action": "create",
                        "id": "gate_intro.json",
                        "data": {
                          "content": {
                            "scenario_mode": "default",
                            "steps": [
                              {
                                "id": "start",
                                "msg": [{ "text": "You found the Rune Key!", "delay": 0 }],
                                "components": [{ "type": "player_give_item", "item_id": 2000000101, "value": 1 }]
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "proposeCreate": {
                  "summary": "Submit a guest change request with idempotency_key",
                  "value": {
                    "message": "Add Rune Key quest item and starter scenario",
                    "idempotency_key": "ai-rune-key-v1",
                    "operations": [
                      {
                        "resource": "items",
                        "action": "create",
                        "tempId": 2000000101,
                        "data": { "Name": "Rune Key", "Description": "Opens the gate", "Type": "Quest" }
                      }
                    ]
                  }
                },
                "proposeRevise": {
                  "summary": "Revise an existing pending change request with optimistic version lock",
                  "value": {
                    "request_id": "cr_0123456789abcdef",
                    "version": 1,
                    "message": "Fixed typo in item description per admin feedback",
                    "operations": [
                      {
                        "resource": "items",
                        "action": "create",
                        "tempId": 2000000101,
                        "data": { "Name": "Rune Key", "Description": "Opens the ancient gate", "Type": "Quest" }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result, dry-run diff preview, or submitted change request",
            "content": {
              "application/json": {
                "examples": {
                  "validateOk": {
                    "value": { "ok": true, "valid": true, "errors": [], "warnings": [], "normalized_operations": [] }
                  },
                  "previewOk": {
                    "value": {
                      "ok": true,
                      "valid": true,
                      "analysis": {
                        "summary": { "create": 1, "update": 0, "delete": 0, "fields": 3 },
                        "tempIds": { "2000000101": { "resource": "items", "label": "Rune Key" } },
                        "items": [{ "resource": "items", "action": "create", "id": 2000000101, "diff": [] }]
                      },
                      "warnings": [],
                      "normalized_operations": []
                    }
                  },
                  "proposeCreated": {
                    "value": {
                      "ok": true,
                      "duplicate": false,
                      "warnings": [],
                      "request": {
                        "id": "cr_0123456789abcdef",
                        "status": "pending",
                        "version": 1,
                        "message": "Add Rune Key quest item and starter scenario",
