# mysql_bridge.py 2.0 (Python 3.8+). Copy to bridge.cfg (chmod 600):
#   python3 mysql_bridge.py bridge.cfg
#   python3 mysql_bridge.py bridge.cfg --check-config
# Environment overrides: BRIDGE_{LISTEN_HOST,LISTEN_PORT,LOG_LEVEL},
# BRIDGE_PRIMARY_{HOST,PORT}, BRIDGE_REPLICA_{HOST,PORT,USER,PASSWORD,PASSWORD_FILE}.
# In a normal install edit: [bridge] listen_host, [primary] host,
# [replica] password (or password_file / BRIDGE_REPLICA_PASSWORD).
# Only the shared database is replicated; local databases stay on the primary
# and their reads always go there.

[bridge]
# Game servers connect here. Loopback only by default; the hop is plain MySQL,
# so keep it on localhost/LAN and set sv_sql_use_tls 0.
listen_host = 127.0.0.1
listen_port = 33060
# Source IP/CIDR allowlist (comma-separated); others are refused before login.
#allowed_clients = 127.0.0.1/32, 10.0.0.0/8
max_clients = 64
# Persistent replica connections, shared by all clients. Keep above the total
# SQL connections of all game servers (sv_sql_pool_size each + synchronous);
# exhaustion means a wait, then a fallback to the primary.
replica_pool_size = 16
# false = send everything to the primary (incident mode, plain relay).
route_selects_to_replica = true
# After a write, matching reads use the primary this long (0 = off); keep it
# above the replication lag.
read_your_writes_grace_sec = 2.0
# table (recommended) | global | connection - who is affected; see README.
#read_your_writes_scope = table
# >0: poll the replica lag and bypass it while behind, stopped or unknown.
# Needs GRANT REPLICA MONITOR (MariaDB 10.5+; older: REPLICATION CLIENT).
#max_replica_lag_sec = 0
#replica_lag_check_interval_sec = 2
# 0 disables; keep above the game server's 60 s idle reuse.
#client_idle_timeout_sec = 600
#auth_timeout_sec = 10
# Wait for a free replica slot, then use the primary. Keep below the WAN RTT.
#replica_acquire_timeout_sec = 0.25
# Slower replica queries are re-run on the primary.
#replica_query_timeout_sec = 30
# Buffer replica responses up to this size so a failure is invisible; bigger
# responses are streamed.
#replica_buffer_kb = 1024
#max_packet_mb = 64
# Stats line period (0 = off); DEBUG logs every routing decision.
#stats_interval_sec = 30
#log_level = INFO
#use_uvloop = true

[primary]
# Writes and everything non-SELECT. No user/password: the game server's login
# is relayed and checked here.
host = db-central.example.com
port = 3306
#connect_timeout_sec = 5
# TLS: tls_mode=mysql (in-protocol) or direct (TLS-first proxy). The
# certificate is verified (tls_ca_file or system CAs, tls_server_name); with
# use_tls = true a server without TLS is refused.
use_tls = false
#tls_mode = mysql
#tls_ca_file = /etc/mysql/ssl/ca.pem
#tls_verify = true
#tls_server_name = db-central.example.com
#tls_cert_file =
#tls_key_file =

[replica]
# Read replica in this location (or [primary] itself for a plain proxy).
# It carries the shared database only; local databases are read from the
# primary.
host = 127.0.0.1
port = 3306
#connect_timeout_sec = 3
# SELECT-only account on the replica, shared database only (mrpg_shared).
# mysql_native_password is simplest; caching_sha2_password needs use_tls.
user = mrpg_bridge
password = changeme
#password_file = /etc/mrpg/bridge_replica_password
# Database for reads without a default one.
database = mrpg_shared
# Same TLS keys as [primary]; usually unnecessary on 127.0.0.1.
use_tls = false
